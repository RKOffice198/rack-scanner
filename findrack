<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no"><title>Rack Finder</title><script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script><style>
*{box-sizing:border-box}body{margin:0;font-family:Arial;background:#f1f5f9;color:#111827}.app{max-width:620px;margin:auto;padding:14px}.head,.card,.result{background:#fff;border-radius:20px;padding:18px;margin-bottom:14px;box-shadow:0 4px 14px #00000012}.head{background:#111827;color:#fff;text-align:center}.head h1{margin:0;font-size:29px}.head p{margin:7px 0 0;color:#cbd5e1;font-weight:700}.title{text-align:center;font-size:19px;font-weight:900;margin-bottom:12px}.input{width:100%;height:62px;border:3px solid #cbd5e1;border-radius:15px;padding:0 15px;font-size:19px;font-weight:700}.row{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:10px}button{border:0;border-radius:15px;min-height:58px;font-size:18px;font-weight:900}.scan{background:#111827;color:#fff}.search{background:#2563eb;color:#fff}.refresh{background:#e2e8f0;width:100%;margin-top:10px}.status{text-align:center;color:#64748b;font-size:13px;font-weight:700;margin-top:8px}.result{display:none;text-align:center}.result.show{display:block}.found{background:#dcfce7;border:5px solid #16a34a}.notfound{background:#fee2e2;border:5px solid #dc2626}.rt{font-size:25px;font-weight:900}.rm{font-size:22px;font-weight:900;word-break:break-word}.rl{margin-top:16px;font-size:16px;font-weight:900;color:#475569}.rack{font-size:52px;font-weight:1000;color:#15803d;margin-top:7px}.pills{display:flex;flex-wrap:wrap;justify-content:center;gap:10px;margin-top:10px}.pill{background:#16a34a;color:#fff;border-radius:14px;padding:12px 18px;font-size:28px;font-weight:1000}.nf{font-size:21px;font-weight:900;color:#b91c1c}.overlay{display:none;position:fixed;inset:0;z-index:1000;background:#000d;padding:12px;align-items:center;justify-content:center}.overlay.show{display:flex}.cam{width:100%;max-width:600px;max-height:95vh;overflow:auto;background:#fff;border-radius:22px;padding:12px;text-align:center}.ct{font-size:22px;font-weight:900;margin:4px 0 10px}#reader{width:100%;overflow:hidden;border-radius:17px}.controls{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px}.ctrl{background:#e2e8f0}.ctrl.on{background:#f59e0b;color:#fff}.close{background:#dc2626;color:#fff;width:100%;margin-top:10px}.zoom{text-align:left;margin-top:10px;font-weight:900}.zoom input{width:100%}.zv{text-align:center}.disabled{opacity:.5}
</style></head><body><div class="app"><div class="head"><h1>📍 RACK FINDER</h1><p>Scan Product Code → Find Rack Column</p></div><div class="card"><div class="title">PRODUCT CODE</div><input id="inp" class="input" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" placeholder="Scan or type product code"><div class="row"><button class="scan" onclick="openCamera()">📷 SCAN CAMERA</button><button class="search" onclick="search()">🔎 SEARCH</button></div><button class="refresh" onclick="loadData()">↻ REFRESH SHEET DATA</button><div id="status" class="status">Loading...</div></div><div id="res" class="result"><div id="title" class="rt"></div><div id="model" class="rm"></div><div class="rl">RACK COLUMN</div><div id="rack"></div></div></div><div id="camOverlay" class="overlay"><div class="cam"><div class="ct">📷 SCAN PRODUCT QR</div><div id="reader"></div><div class="zoom">🔍 Camera Zoom<input id="zoom" type="range" min="1" max="1" step="0.1" value="1" oninput="setZoom(this.value)"><div id="zv" class="zv">1.0×</div></div><div class="controls"><button id="flash" class="ctrl" onclick="toggleFlash()">🔦 FLASH OFF</button><button class="ctrl" onclick="resetZoom()">↺ RESET ZOOM</button></div><button class="close" onclick="closeCamera()">CLOSE CAMERA</button></div></div><script>
const API_URL="https://script.google.com/macros/s/AKfycbwB_AWk6NrWUimxecJVpiM0RIFkDPK1RmWLLnGk61L2Unt-jlL_0qV9_xkK-ZOZZO1k/exec";let rows=[],scanner=null,running=false,opening=false,track=null,flashOn=false,last="",lastTime=0,zmin=1,zmax=1,zstep=.1;
function api(p,ok,fail){let cb="rf_"+Date.now()+Math.random().toString(36).slice(2),s=document.createElement("script");p.callback=cb;let q=Object.keys(p).map(k=>encodeURIComponent(k)+"="+encodeURIComponent(p[k])).join("&"),to=setTimeout(()=>{clean();fail&&fail("Connection timeout.")},15000);function clean(){clearTimeout(to);s.remove();try{delete window[cb]}catch(e){}}window[cb]=d=>{clean();d&&d.success===false?(fail&&fail(d.error||"Server error.")):ok&&ok(d)};s.src=API_URL+"?"+q;s.onerror=()=>{clean();fail&&fail("Could not connect to Google Sheet.")};document.body.appendChild(s)}
function loadData(){status.textContent="Loading sheet data...";api({action:"list"},d=>{rows=d.rows||[];status.textContent=rows.length+" records loaded from Google Sheet."},e=>status.textContent="ERROR: "+e)}
function modelOf(v){v=String(v||"").trim();let p=v.lastIndexOf("-");return p>0?v.slice(0,p).trim():v}
function search(){let v=inp.value.trim();if(!v){showNF("","Please scan or enter a product code.");return}let m=modelOf(v),key=m.toLowerCase(),matches=rows.filter(r=>String(r.model||"").trim().toLowerCase()===key);model.textContent=m;if(matches.length){res.className="result found show";title.textContent="✓ PRODUCT FOUND";let a=[];matches.forEach(r=>{let x=String(r.rack||"").trim();if(x&&!a.includes(x))a.push(x)});rack.className=a.length===1?"rack":"pills";rack.innerHTML=a.length===1?esc(a[0]):a.map(x=>'<div class="pill">'+esc(x)+"</div>").join("")}else showNF(m,"Rack column not found in the sheet.")}
function showNF(m,msg){res.className="result notfound show";title.textContent="✕ NOT FOUND";model.textContent=m;rack.className="nf";rack.textContent=msg}function esc(x){return String(x).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#039;")}
inp.addEventListener("keydown",e=>{if(e.key==="Enter"){e.preventDefault();search()}});
function openCamera(){if(running||opening)return;camOverlay.classList.add("show");setTimeout(startCamera,150)}
function startCamera(){if(running||opening)return;opening=true;scanner=new Html5Qrcode("reader");scanner.start({facingMode:{exact:"environment"}},{fps:20,qrbox:(w,h)=>{let s=Math.floor(Math.min(w,h)*.72);return{width:s,height:s}},aspectRatio:1,disableFlip:false},text=>{let n=Date.now();if(text===last&&n-lastTime<1800)return;last=text;lastTime=n;inp.value=text;closeCamera();search()},()=>{}).then(()=>{opening=false;running=true;setTimeout(capabilities,250)}).catch(e=>{opening=false;alert("Camera could not be opened.\n\n"+e)})}
function capabilities(){let v=document.querySelector("#reader video");if(v&&v.srcObject){let t=v.srcObject.getVideoTracks();if(t.length)track=t[0]}if(!track)return;let c={};try{c=track.getCapabilities()}catch(e){}if(c.zoom){zmin=+c.zoom.min;zmax=+c.zoom.max;zstep=+(c.zoom.step||.1);zoom.min=zmin;zoom.max=zmax;zoom.step=zstep;zoom.value=zmin;zv.textContent=zmin.toFixed(1)+"×"}else{zoom.min=zoom.max=zoom.value=1;zv.textContent="Not supported"}if(c.torch){flash.disabled=false;flash.textContent="🔦 FLASH OFF"}else{flash.disabled=true;flash.textContent="🔦 NOT SUPPORTED";flash.classList.add("disabled")}}
function setZoom(v){let n=+v;zv.textContent=zmax>zmin?n.toFixed(1)+"×":"Not supported";if(track)try{track.applyConstraints({advanced:[{zoom:n}]})}catch(e){}}
function resetZoom(){if(zmax>zmin){zoom.value=zmin;setZoom(zmin)}}
function toggleFlash(){if(!track)return;let c={};try{c=track.getCapabilities()}catch(e){}if(!c.torch)return;flashOn=!flashOn;track.applyConstraints({advanced:[{torch:flashOn}]}).then(()=>{flash.textContent=flashOn?"🔦 FLASH ON":"🔦 FLASH OFF";flash.classList.toggle("on",flashOn)}).catch(()=>{flashOn=!flashOn;alert("Flash could not be changed on this phone/browser.")})}
function stopCamera(){if(!scanner||!running)return Promise.resolve();return scanner.stop().then(()=>running=false).catch(()=>running=false)}function closeCamera(){stopCamera().finally(()=>{opening=false;track=null;flashOn=false;camOverlay.classList.remove("show");flash.textContent="🔦 FLASH OFF";flash.classList.remove("on","disabled");zoom.value=1;zv.textContent="1.0×"})}
window.addEventListener("load",loadData);const inp=document.getElementById("inp"),status=document.getElementById("status"),res=document.getElementById("res"),title=document.getElementById("title"),model=document.getElementById("model"),rack=document.getElementById("rack"),camOverlay=document.getElementById("camOverlay"),zoom=document.getElementById("zoom"),zv=document.getElementById("zv"),flash=document.getElementById("flash");
</script></body></html>
